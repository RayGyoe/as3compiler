# macOS
.DS_Store

# Node
node_modules/

# Generated build artifacts: AS source -> C -> native executable / wasm
*.c
*.o
*.wasm
build/

# The npm publish artifact: src/*.ts -> dist/*.js, produced by scripts/build-dist.ts
# (wired to `prepare`, so `npm pack` and `npm publish` regenerate it). It is a build
# OUTPUT of tracked sources -- tracking it too would only give the next publish a
# stale tree to ship, since nothing would catch the drift.
dist/

# ...but hand-written / vendored C sources ARE tracked build INPUTS, exactly like
# the vendor/**.cc and vendor/**.mm glue files (which the *.c rule never touched):
# the SQLite amalgamation engine + its glue, and the CoreAudio / SystemConfiguration
# backends. Without this the flash.data engine would silently stay out of the repo
# and a fresh clone could not build it. shell.c is the amalgamation's CLI (it ships
# its own main()) and our build never compiles it, so it stays out on purpose.
!vendor/**/*.c
vendor/sqlite/shell.c

# Same reasoning, same trap, for the FRE host forwarder in lib/: asaot_host.c is
# hand-written (not generated from AS3), and asaot.h is the ABI contract every
# recompiled ANE is compiled against. The `*.c` rule above would have swallowed it
# and left a fresh clone unable to build lib/bin/*/asaot.dll -- i.e. unable to load
# any extension at all, with nothing in the checkout to explain why. Scoped to the
# *.c case on purpose: a bare `!lib/` here would also un-ignore lib/bin/**, and a
# host library is a build product that gets regenerated by lib/build-asaot.bat.
!lib/*.c

# Compiled example executables (extensionless, generated from the same-named .as).
# Keep the .as sources, the build-manifest / exporter configs, and the notes that
# explain a directory whose SOURCES are external (see examples/EXTERNAL-FIXTURES.md).
examples/*
!examples/*.as
!examples/*.json
!examples/*.md
!examples/*/

# Generated wasm export manifests (written next to the .wasm by src/index.ts:959).
# They are build output, not inputs — nothing reads them back — so they stay out of the
# tree just like the .c and the executable. This must come AFTER the `!examples/*.json`
# line above, which exists for the HAND-WRITTEN manifests (`*.build.json` / `*.build.example.json`)
# and would otherwise un-ignore these too.
examples/**/*.exports.json

# Compiled executables under example subdirectories.
# (extensionless Mach-O/ELF, regenerated from the same-named .as)
examples/air-native/air-native
examples/air-native/air-native-offscreen
# --air-app writes its build manifest beside the descriptor it read, named after
# that descriptor's <filename>, and the paths inside it are relative to the
# descriptor -- so it is regenerated on every run, never authored. Keeping one in
# the tree only means a platform-specific snapshot the next build overwrites (the
# committed copy of air-native's was Windows-generated), so they are all ignored.
# The hand-written manifests are DIFFERENT and stay tracked: examples/audio.build.json
# and friends next to their .as, examples/textfield/textfield.build.json, and
# examples/web/hello-web.build.json (the canonical web manifest airManifest mirrors).
examples/ane-app/ane-app.build.json
examples/air-native/air-native.build.json
examples/air-native/air-native-offscreen.build.json
examples/shmup-stage3d/shmup-stage3d.build.json
examples/air-native/src/demo/ArrayDemos
examples/wasm-native/demo
examples/wasm-native/export-meta
examples/stage12/Greeter
examples/web/hello-web

# Windows native build outputs (host-regenerated on every build): `--air-app` links
# an `.exe` plus its import `.lib`, and deploys the Skia text-shaping data
# `icudtl.dat` beside the executable. Scoped to examples/ on purpose --
# vendor/**/*.lib are tracked build INPUTS and must not be swallowed by a global
# `*.lib` rule.
examples/**/*.exe
examples/**/*.lib
examples/**/icudtl.dat
benchmarks/**/*.exe

# Local acceptance-test demo projects. These are EXTERNAL, read-only reference trees,
# so the whole directory stays out: their sources are third-party (Flappy-Starling,
# the Starling framework and its demo scene, the url-test probe app) and their build
# outputs (extensionless executable, Demo.swf, .data bundle, web .html/.js) are
# regenerated by build-and-run.sh -- committing one only puts a platform-specific
# snapshot in the tree for the next build to overwrite. The suite skips them via
# SKIP_DIRS, and a directory that is absent is simply never enumerated, so a fresh
# clone is green without them. Re-clone recipe: examples/EXTERNAL-FIXTURES.md.
examples/Flappy-Starling/
examples/air-starling-demo/
examples/url-test

# Stage3D demo build artifacts (regenerated by build-and-run.sh / the AOT native+web targets).
examples/shmup-stage3d/main.swf
examples/shmup-stage3d/shmup-stage3d
examples/shmup-stage3d/shmup-stage3d.html
examples/shmup-stage3d/shmup-stage3d.js

# away3d-core is an EXTERNAL FIXTURE, not a tracked example: it is the away3d-core-fp11
# engine (479 .as files, Apache-2.0) cloned beside the repo as the `adl` reference
# for the Stage3D / native-shader work (enhancement E6) -- "what AIR actually
# renders" -- and its sources use features outside the subset, so it is never
# regression input. Its build outputs (extensionless executables, .data/.html/.js
# bundles) are host-specific regenerated artifacts of the same non-tree. Both kinds
# stay out; re-clone with the recipe in examples/EXTERNAL-FIXTURES.md. The suite
# treats a missing fixture as a skip, not a failure (test/examples.ts SKIP_DIRS).
examples/away3d-core/

# The web example ships only the font its manifest actually lists (fonts/Arial.ttf).
# MiSans lives once, under examples/air-native/fonts/, where air-native-app.xml
# declares it -- do not re-add a second copy here.
examples/web/fonts/MiSans-Regular.ttf

# Benchmark executables: *_asc (AS3-compiled) and *_c (handwritten C baseline),
# plus the *_air.swf reference builds regenerated by benchmarks/run.py (mxmlc).
benchmarks/*/*_asc
benchmarks/*/*_c
benchmarks/*/*_air.swf

temp

scratch

# Transient junk from local adl / desktop test runs (never a build input).
adl.pid
pid.txt
examples/air-native/air-native.log

# Root-level scratch screenshots dumped by local probe scripts. Real image assets
# live under examples/ or docs/ (nothing at the repo root is tracked).
/*.png

# Python bytecode caches from the probe scripts under examples/ (the .py sources
# themselves are tracked).
__pycache__/
*.pyc