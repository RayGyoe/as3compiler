# sdl pkg-config source file

prefix=/Users/ray.lei/Documents/as3compiler-aot/as3compiler/vendor/sdl2/SDL2-2.32.10/build-arm64/../../arm64
exec_prefix=${prefix}
libdir=${exec_prefix}/lib
includedir=${prefix}/include

Name: sdl2
Description: Simple DirectMedia Layer is a cross-platform multimedia library designed to provide low level access to audio, keyboard, mouse, joystick, 3D hardware via OpenGL, and 2D video framebuffer.
Version: 2.32.10
Requires.private: 
Conflicts:
Libs: -L${libdir}  -lSDL2   -lm  -lobjc -Wl,-framework,CoreVideo -Wl,-framework,Cocoa -Wl,-framework,Carbon -Wl,-framework,IOKit -Wl,-weak_framework,QuartzCore -Wl,-weak_framework,Metal
Cflags: -I${includedir} -I${includedir}/SDL2  -D_THREAD_SAFE
