{
  "name": "as3compiler",
  "version": "0.4.295",
  "description": "A minimal ActionScript 3 subset compiler that transpiles AS to C and produces a native executable.",
  "type": "module",
  "bin": {
    "as-aot": "dist/index.js"
  },
  "files": [
    "dist",
    "docs",
    "README-CN.md",
    "LICENSE"
  ],
  "scripts": {
    "compile": "node src/index.ts",
    "build:dist": "node scripts/build-dist.ts",
    "prepare": "node scripts/build-dist.ts",
    "test": "node test.ts",
    "test:unit": "node --test test/unit/*.ts",
    "test:examples": "node --test test/examples.ts"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "license": "MIT"
}
