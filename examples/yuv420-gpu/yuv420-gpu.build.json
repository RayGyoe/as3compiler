{
  "target": "native",
  "c-compiler": "clang",
  "opt": "-O2",
  "architecture": "64",
  "sources": [
    "../../vendor/skia_glue.cc",
    "../../vendor/window_glue.cc",
    "${mac:../../vendor/metal_glue.mm}",
    "${win:../../vendor/d3d_glue.cc}"
  ],
  "include-paths": [
    "../../vendor/skia",
    "../../vendor/sdl2/include/${host}",
    "${win:../../vendor/curl/include}"
  ],
  "link-libs": [
    "skia",
    "skparagraph",
    "skshaper",
    "skunicode",
    "skottie",
    "sksg",
    "svg",
    "skresources",
    "bentleyottmann",
    "skcms",
    "wuffs",
    "${lib:png}",
    "${lib:jpeg}",
    "${lib:webp}",
    "${lib:webp_sse41}",
    "dng_sdk",
    "piex",
    "expat",
    "freetype2",
    "harfbuzz",
    "icu",
    "zlib",
    "z",
    "SDL2",
    "${mac:objc}",
    "${win:d3d12}",
    "${win:dxgi}",
    "${win:d3dcompiler}",
    "${win:d3d12allocator}",
    "${win:usp10}",
    "${win:user32}",
    "${win:gdi32}",
    "${win:ole32}",
    "${win:advapi32}",
    "${win:winmm}",
    "${win:imm32}",
    "${win:oleaut32}",
    "${win:version}",
    "${win:uuid}",
    "${win:setupapi}",
    "${win:shell32}",
    "${win:dinput8}"
  ],
  "link-paths": [
    "../../vendor/skia/lib/${host}",
    "../../vendor/sdl2/lib/${host}",
    "${win:../../vendor/curl/lib/${host}}"
  ],
  "frameworks": [
    "CoreFoundation",
    "CoreGraphics",
    "CoreText",
    "CoreServices",
    "ApplicationServices",
    "ImageIO",
    "Accelerate",
    "CoreVideo",
    "Cocoa",
    "Carbon",
    "IOKit",
    "Metal",
    "QuartzCore"
  ],
  "defines": [
    "ASC_USE_SKIA=1",
    "ASC_USE_WINDOW=1",
    "ASC_WINDOW_FIXED=1",
    "ASC_WINDOW_FRAME_SIZE=1",
    "ASC_RENDER_WINGPU=1",
    "${mac:ASC_RENDER_METAL=1}",
    "${win:ASC_RENDER_D3D=1}",
    "ASC_APP_ID=\"demo.as3.yuv420gpu\"",
    "ASC_SWF_PATH=\"main.swf\""
  ],
  "features": [
    "yuv420"
  ],
  "objects": [],
  "bundle-id": "demo.as3.yuv420gpu",
  "display-name": "yuv420-gpu",
  "version": "1.0"
}
