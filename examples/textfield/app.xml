<application xmlns="http://ns.adobe.com/air/application/51.0">
    <id>textfieldprobe</id>
    <versionNumber>0.0.1</versionNumber>
    <filename>textfieldprobe</filename>
    <initialWindow>
        <content>Main.swf</content>
        <visible>false</visible>
        <width>400</width>
        <height>400</height>
    </initialWindow>
</application>
