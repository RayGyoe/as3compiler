{
  "target": "native",
  "c-compiler": "clang",
  "opt": "-O2",
  "architecture": "64",
  "sources": [
    "../../vendor/skia_glue.cc",
    "../../vendor/window_glue.cc",
    "../../vendor/audio_glue.c"
  ],
  "include-paths": [
    "../../vendor/skia",
    "../../vendor/sdl2/include/${host}",
    "../../vendor/curl/include"
  ],
  "link-libs": [
    "skia",
    "skparagraph",
    "skshaper",
    "skunicode",
    "skottie",
    "sksg",
    "svg",
    "skresources",
    "bentleyottmann",
    "skcms",
    "wuffs",
    "${lib:png}",
    "${lib:jpeg}",
    "${lib:webp}",
    "${lib:webp_sse41}",
    "dng_sdk",
    "piex",
    "expat",
    "freetype2",
    "harfbuzz",
    "icu",
    "zlib",
    "z",
    "SDL2",
    "${mac:objc}",
    "${win:usp10}",
    "${win:user32}",
    "${win:gdi32}",
    "${win:ole32}",
    "${win:advapi32}",
    "${win:d3d12}",
    "${win:dxgi}",
    "${win:d3dcompiler}",
    "${win:winmm}",
    "${win:imm32}",
    "${win:oleaut32}",
    "${win:version}",
    "${win:uuid}",
    "${win:setupapi}",
    "${win:shell32}",
    "${win:dinput8}",
    "curl",
    "nghttp2",
    "${win:crypt32}",
    "${win:ws2_32}",
    "${win:secur32}",
    "${win:bcrypt}",
    "${win:iphlpapi}"
  ],
  "link-paths": [
    "../../vendor/skia/lib/${host}",
    "../../vendor/sdl2/lib/${host}",
    "../../vendor/curl/lib/${host}"
  ],
  "frameworks": [
    "CoreFoundation",
    "CoreGraphics",
    "CoreText",
    "CoreServices",
    "ApplicationServices",
    "ImageIO",
    "Accelerate",
    "CoreVideo",
    "Cocoa",
    "Carbon",
    "IOKit",
    "Metal",
    "QuartzCore",
    "CoreAudio",
    "AudioToolbox",
    "Security",
    "SystemConfiguration"
  ],
  "defines": [
    "ASC_USE_SKIA=1",
    "ASC_USE_WINDOW=1",
    "ASC_HAVE_AUDIO=1",
    "ASC_HAVE_CURL=1",
    "CURL_STATICLIB=1"
  ],
  "objects": []
}
