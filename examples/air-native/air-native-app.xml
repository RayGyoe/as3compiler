<?xml version="1.0" encoding="UTF-8"?>
<application xmlns="http://ns.adobe.com/air/application/51.0">
  <id>demo.as3.native</id>
  <versionNumber>1.0</versionNumber>
  <filename>air-native</filename>
  <architecture>64</architecture>
  <initialWindow>
    <content>main.swf</content>
    <title>Native AS3 Demo</title>
    <visible>true</visible>
    <width>1000</width>
    <height>680</height>
    <resizable>true</resizable>
    <renderMode>direct</renderMode>
    <requestedDisplayResolution>high</requestedDisplayResolution> 
  </initialWindow>
  <embedFonts>
    <font>
      <fontPath>fonts/MiSans-Regular.ttf</fontPath>
      <fontName>MiSans</fontName>
    </font>
    <font>
      <fontPath>fonts/Arial.ttf</fontPath>
      <fontName>Arial</fontName>
    </font>
  </embedFonts>
</application>
